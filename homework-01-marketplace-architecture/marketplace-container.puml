@startuml MarketplaceContainer
!include <C4/C4_Container>

title Marketplace - C4 Container Diagram
LAYOUT_LEFT_RIGHT()

Person(buyer, "Покупатель", "Просматривает ленту и оформляет заказы")
Person(seller, "Продавец", "Управляет товарами и остатками")

System_Ext(payment_provider, "Платежный провайдер", "Обрабатывает платежные операции")
System_Ext(notification_provider, "Провайдер уведомлений", "Доставляет email, SMS и push")

System_Boundary(marketplace, "Marketplace") {
    Container(web, "Web Application", "Browser application", "Интерфейс покупателей и продавцов")
    Container(gateway, "API Gateway", "HTTP API", "Единая точка входа и маршрутизация запросов")

    Container(identity, "Identity Service", "Service", "Учетные записи, роли и профили")
    Container(catalog, "Catalog Service", "Service", "Товары, категории, цены и остатки")
    Container(recommendation, "Recommendation Service", "Service", "Персональная лента товаров")
    Container(order, "Order Service", "Service", "Создание заказов и управление статусами")
    Container(payment, "Payment Service", "Service", "Расчет и учет платежей")
    Container(notification, "Notification Service", "Service", "Уведомления о статусах заказа")

    ContainerQueue(broker, "Message Broker", "Kafka-compatible broker", "Асинхронные доменные события")

    ContainerDb(identity_db, "Identity DB", "Relational database", "Пользователи, роли и профили")
    ContainerDb(catalog_db, "Catalog DB", "Relational database", "Товары, категории, цены и остатки")
    ContainerDb(recommendation_db, "Recommendation Store", "Data store", "Сигналы и рассчитанные рекомендации")
    ContainerDb(order_db, "Order DB", "Relational database", "Заказы, позиции и статусы")
    ContainerDb(payment_db, "Payment DB", "Relational database", "Платежные операции и статусы")
    ContainerDb(notification_db, "Notification DB", "Relational database", "Шаблоны и журнал доставки")
}

Rel(buyer, web, "Использует", "HTTPS")
Rel(seller, web, "Использует", "HTTPS")
Rel(web, gateway, "Отправляет запросы", "HTTPS/JSON, sync")

Rel(gateway, identity, "Управляет учетной записью", "HTTP/JSON, sync")
Rel(gateway, catalog, "Читает и изменяет каталог", "HTTP/JSON, sync")
Rel(gateway, recommendation, "Получает ленту и передает сигналы о просмотрах", "HTTP/JSON, sync")
Rel(gateway, order, "Создает и читает заказы", "HTTP/JSON, sync")

Rel(order, catalog, "Проверяет цену и резервирует остаток", "HTTP/JSON, sync")
Rel(order, payment, "Инициирует платеж", "HTTP/JSON, sync")
Rel(payment, payment_provider, "Создает платежную операцию", "HTTPS, sync")
Rel(payment_provider, payment, "Сообщает финальный статус", "HTTPS webhook, async")
Rel(notification, notification_provider, "Отправляет сообщение", "HTTPS")

Rel(identity, identity_db, "Читает и записывает")
Rel(catalog, catalog_db, "Читает и записывает")
Rel(recommendation, recommendation_db, "Читает и записывает")
Rel(order, order_db, "Читает и записывает")
Rel(payment, payment_db, "Читает и записывает")
Rel(notification, notification_db, "Читает и записывает")

Rel(identity, broker, "Публикует UserUpdated", "async")
Rel(catalog, broker, "Публикует ProductUpdated", "async")
Rel(order, broker, "Публикует OrderStatusChanged", "async")
Rel(payment, broker, "Публикует PaymentSucceeded/Failed", "async")
Rel(broker, order, "Доставляет результат платежа", "async")
Rel(broker, recommendation, "Доставляет сигналы каталога и заказов", "async")
Rel(broker, notification, "Доставляет статусы заказа и платежа", "async")

SHOW_LEGEND()
@enduml
